# Plantilla para configurar Groq en el grafo.
# Copia este archivo a .env y ejecuta con `--env-file .env`.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama sigue disponible para el pipeline anterior.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_HOST=http://localhost:11434
LLM_MAX_ATTEMPTS=3

# Si tu modelo lo admite, activa el modo de razonamiento con:
OLLAMA_THINK=false
